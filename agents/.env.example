# ============================================================
# agents/.env.example — copy to .env and fill in real values
# NEVER commit the .env file with real secrets to version control
# ============================================================

# === OpenAI ===
OPENAI_API_KEY=your-openai-api-key-here

# === Tavily Web Search ===
TAVILY_API_KEY=your-tavily-api-key-here

# === LangSmith Tracing (optional but recommended) ===
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=multi-agent

# === LLM Settings ===
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

# === Router LLM Settings ===
# Used by the intent classifier. If omitted, these fall back to the custom LLM
# settings when LLM_PROVIDER=custom_openai_compatible, otherwise to LLM_MODEL.
ROUTER_MODEL=gpt-4o
ROUTER_BASE_URL=
ROUTER_API_KEY=
ROUTER_TEMPERATURE=0.0
ROUTER_MAX_TOKENS=

# === ChromaDB — set to /data/chroma_db in Railway (persistent volume) ===
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=medical_info

# === Retrieval ===
RETRIEVAL_TOP_K=10
ENSEMBLE_DENSE_WEIGHT=0.5

# === Supabase (optional — for corpus loading from cloud) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_TABLE=sl_med_corpus

# === CORS — set to your Railway frontend URL in production ===
# Example: FRONTEND_URL=https://my-frontend.up.railway.app
FRONTEND_URL=*
